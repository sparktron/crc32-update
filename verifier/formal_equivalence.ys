# Berkeley ABC must successfully synthesize the structural network. Then reload
# both untouched designs, build a combined assertion miter, and emit it for the
# companion Yosys SMTBMC/Z3 proof.

read_verilog reference/crc32_reference.v
read_verilog verifier/fixtures/valid_crc32_network.v
proc
design -save source_design
hierarchy -check -top crc32_network
flatten
opt
techmap
opt
abc -exe yosys-abc -g simple
opt
check
design -load source_design
miter -equiv -flatten -make_assert crc32_reference crc32_network crc32_miter
prep -top crc32_miter
write_smt2 -wires /tmp/crc32_equivalence_miter.smt2
